# Copy this file to .env and fill in the values. Never commit .env.
# A unit test (apps/api/test/unit/config.test.ts) fails if this list and
# apps/api/src/config.ts disagree, or if a value is filled in here.

# Port of the HTTP API. Default: 3000.
PORT=
# Secret that signs paging cursors. At least 32 characters.
# Make one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CURSOR_SECRET=
# Path of the place dataset, relative to apps/api. Default: data/places.sample.json.
PLACES_DATA_FILE=
