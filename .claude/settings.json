{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm run test:contract)",
      "Bash(npm run check)",
      "Bash(npm run dev)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Edit(./apps/api/src/**)",
      "Edit(./apps/api/test/unit/**)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm update:*)",
      "Bash(npm uninstall:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh api:*)",
      "Edit(./docs/contract/**)",
      "Edit(./apps/api/test/contract/**)",
      "Edit(./apps/api/test/support/**)",
      "Edit(./apps/api/data/**)",
      "Edit(./.github/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./AGENTS.md)",
      "Edit(./.claude/settings.json)",
      "Edit(./eslint.config.js)",
      "Edit(./.prettierrc.json)",
      "Edit(./apps/api/vitest.config.ts)",
      "Edit(./apps/api/tsconfig.json)",
      "Edit(./package.json)",
      "Edit(./apps/api/package.json)",
      "Edit(./.env.example)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push origin :*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git reset --hard:*)",
      "Bash(git tag -d:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh api -X PUT:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api -X PATCH:*)",
      "Bash(gh api --method PUT:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api --method PATCH:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
